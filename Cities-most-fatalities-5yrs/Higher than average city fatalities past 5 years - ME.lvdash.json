{
  "datasets": [
    {
      "name": "f3645a84",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `data_analysis_study_project`;\n",
        "\n",
        "WITH city_fatalities AS (\n",
        "  SELECT \n",
        "    COUNTRY, \n",
        "    ADMIN1 AS CITY,\n",
        "    any_value(CENTROID_LATITUDE) AS CENTROID_LATITUDE,\n",
        "    any_value(CENTROID_LONGITUDE) AS CENTROID_LONGITUDE,\n",
        "    SUM(FATALITIES) AS TOTAL_FATALITIES\n",
        "  FROM workspace.data_analysis_study_project.`me-conflict-zones-study-project`\n",
        "  WHERE to_date(WEEK, 'dd-MMMM-yyyy') >= date_add(current_date(), -5 * 365)\n",
        "  GROUP BY COUNTRY, ADMIN1\n",
        "),\n",
        "avg_city_fatalities AS (\n",
        "  SELECT AVG(TOTAL_FATALITIES) AS avg_fatalities\n",
        "  FROM city_fatalities\n",
        ")\n",
        "SELECT \n",
        "  COUNTRY, \n",
        "  CITY, \n",
        "  CENTROID_LATITUDE,\n",
        "  CENTROID_LONGITUDE,\n",
        "  TOTAL_FATALITIES\n",
        "FROM city_fatalities, avg_city_fatalities\n",
        "WHERE TOTAL_FATALITIES > avg_city_fatalities.avg_fatalities\n",
        "ORDER BY TOTAL_FATALITIES DESC"
      ]
    }
  ],
