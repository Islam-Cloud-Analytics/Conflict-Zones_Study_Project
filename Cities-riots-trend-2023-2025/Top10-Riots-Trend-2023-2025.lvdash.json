{
  "datasets": [
    {
      "name": "79b60393",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `data_analysis_study_project`;\n",
        "\n",
        "SELECT \n",
        "  COUNTRY, \n",
        "  ADMIN1 AS CITY, \n",
        "  to_date(WEEK, 'dd-MMMM-yyyy') AS event_week, \n",
        "  COUNT(*) AS riot_event_count\n",
        "FROM workspace.data_analysis_study_project.`me-conflict-zones-study-project`\n",
        "WHERE EVENT_TYPE = 'Riots'\n",
        "  AND (WEEK LIKE '%2023%' OR WEEK LIKE '%2024%')\n",
        "GROUP BY COUNTRY, CITY, event_week\n",
        "ORDER BY COUNTRY, CITY, event_week"
      ]
    }
  ],
  "pages": [
