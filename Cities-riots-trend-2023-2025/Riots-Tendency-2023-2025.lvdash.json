{
  "datasets": [
    {
      "name": "1da583e3",
      "displayName": "Untitled dataset",
      "queryLines": [
        "SELECT\n",
        "  COUNTRY,\n",
        "  ADMIN1 AS city,\n",
        "  YEAR(to_date(WEEK, 'dd-MMMM-yyyy')) AS year,\n",
        "  COUNT(*) AS riot_count\n",
        "FROM workspace.data_analysis_study_project.`me-conflict-zones-study-project`\n",
        "WHERE\n",
        "  EVENT_TYPE = 'Riots'\n",
        "  AND to_date(WEEK, 'dd-MMMM-yyyy') >= add_months(CURRENT_DATE(), -24)\n",
        "GROUP BY\n",
        "  COUNTRY,\n",
        "  city,\n",
        "  YEAR(to_date(WEEK, 'dd-MMMM-yyyy'))\n",
        "ORDER BY\n",
        "  COUNTRY,\n",
        "  city,\n",
        "  year;"
      ]
    }
  ],
